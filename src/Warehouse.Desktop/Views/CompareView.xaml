<UserControl x:Class="Warehouse.Desktop.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: settings and run controls ===== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <GroupBox Header="Scenarios to compare">
                    <!-- Settings are locked while a comparison is running. -->
                    <Grid IsEnabled="{Binding IsIdle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Number of seeds" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding SeedCount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="First seed" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FirstSeed, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Width" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Height" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Robots" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding RobotCount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Shelf density" />
                        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                            <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding ShelfDensity, StringFormat={}{0:0.00}}" />
                            <Slider Minimum="0" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Value="{Binding ShelfDensity}" />
                        </DockPanel>

                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Threads"
                                   ToolTip="How many plans run at the same time. Use 1 for the cleanest runtime numbers." />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding ThreadCount, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Run">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#555">
                            Each seed is planned with all 3 planners and both robot orders.
                        </TextBlock>
                        <WrapPanel>
                            <Button Content="Run" Command="{Binding RunCommand}" FontWeight="SemiBold" />
                            <Button Content="Cancel" Command="{Binding RunCancelCommand}" />
                            <Button Content="Export CSV…" Command="{Binding ExportCsvCommand}" />
                        </WrapPanel>
                        <ProgressBar Height="18" Margin="0,6,0,4" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressText}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Right: results table and status ===== -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Results" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />

            <Border DockPanel.Dock="Bottom" Padding="8,6" Margin="0,6,0,0" BorderThickness="1" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EEF3F8" />
                        <Setter Property="BorderBrush" Value="#C9D6E3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#FDECEA" />
                                <Setter Property="BorderBrush" Value="#E57373" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B71C1C" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResultsNote}" TextWrapping="Wrap"
                       Foreground="#555" Margin="0,6,0,0" />

            <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Planner" Binding="{Binding PlannerName}" Width="150" />
                    <DataGridTextColumn Header="Robot order" Binding="{Binding OrderingName}" Width="130" />
                    <DataGridTextColumn Header="Success rate" Binding="{Binding SuccessRate, StringFormat={}{0:P1}}" Width="95" />
                    <DataGridTextColumn Header="Avg completion time" Binding="{Binding AvgMakespan, StringFormat={}{0:0.0}, TargetNullValue=–}" Width="135" />
                    <DataGridTextColumn Header="Avg path length" Binding="{Binding AvgPathLength, StringFormat={}{0:0.0}, TargetNullValue=–}" Width="115" />
                    <DataGridTextColumn Header="Avg waits" Binding="{Binding AvgWaits, StringFormat={}{0:0.0}, TargetNullValue=–}" Width="80" />
                    <DataGridTextColumn Header="Avg runtime (ms)" Binding="{Binding AvgRuntimeMs, StringFormat={}{0:0.000}, TargetNullValue=–}" Width="120" />
                    <DataGridTextColumn Header="Avg cells expanded" Binding="{Binding AvgExpandedNodes, StringFormat={}{0:N0}, TargetNullValue=–}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
